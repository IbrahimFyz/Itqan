classDiagram
direction TB

class RecitationSession {
  <<entity>>
  +UUID sessionId
  +UUID learnerId
  +Integer surahId
  +Integer aiModeId
  +DateTime startedAt
  +DateTime? endedAt
  +SessionStatus status
  +Decimal completionPercentage
  +Decimal? masteryScore
  +Integer? totalDurationSeconds
  +Integer totalPauseCount
  +Integer errorCount
  +String? failureReason
  +start(DateTime) void
  +addSegment(RecitationSegment) void
  +recordPause(PauseEvent) void
  +complete(DateTime, Decimal) void
  +abandon(DateTime) void
  +fail(String, DateTime) void
  +calculateCompletion() Decimal
  +canAcceptAudio() Boolean
}
class RecitationSegment {
  <<entity>>
  +UUID segmentId
  +UUID sessionId
  +Integer verseId
  +Integer segmentOrder
  +Integer audioStartMs
  +Integer audioEndMs
  +String? recognizedText
  +Decimal? confidenceScore
  +Decimal? fluencyScore
  +SegmentStatus status
  +attachRecognizedText(String, Decimal) void
  +markProcessing() void
  +attachAnalysis(RecitationAnalysis) void
  +fail() void
  +durationMs() Integer
}
class RecitationAnalysis {
  <<entity>>
  +UUID analysisId
  +UUID segmentId
  +AnalysisStatus status
  +String? modelName
  +String? modelVersion
  +Integer? processingTimeMs
  +DateTime? analyzedAt
  +Decimal? overallConfidence
  +String? failureReason
  +start() void
  +addError(RecitationError) void
  +complete(Decimal) void
  +fail(String) void
  +acceptedErrors() List~RecitationError~
}
class PauseEvent {
  <<entity>>
  +UUID pauseEventId
  +UUID sessionId
  +UUID? segmentId
  +Integer startedAtMs
  +Integer durationMs
  +PauseType pauseType
  +Boolean promptTriggered
  +Integer? promptDelayMs
  +requiresPrompt(Integer) Boolean
  +markPromptTriggered(Integer) void
}
class ErrorType {
  <<entity>>
  +Integer errorTypeId
  +Integer? tajweedRuleId
  +String errorCode
  +ErrorCategory category
  +String nameAr
  +String nameEn
  +String severity
  +String description
  +isTajweedError() Boolean
}
class RecitationError {
  <<entity>>
  +UUID recitationErrorId
  +UUID analysisId
  +Integer errorTypeId
  +Integer? wordId
  +String? detectedText
  +String? expectedText
  +Integer? audioStartMs
  +Integer? audioEndMs
  +Decimal confidenceScore
  +ReviewStatus reviewStatus
  +DateTime detectedAt
  +addFeedback(ErrorFeedback) void
  +accept() void
  +reject() void
  +correct() void
  +hasExactWordLocation() Boolean
}
class ErrorFeedback {
  <<entity>>
  +UUID feedbackId
  +UUID recitationErrorId
  +FeedbackType feedbackType
  +LanguageCode languageCode
  +String feedbackText
  +String? correctionText
  +DateTime createdAt
  +isForLanguage(LanguageCode) Boolean
}
class AudioAssistance {
  <<entity>>
  +UUID assistanceId
  +UUID? recitationErrorId
  +UUID? pauseEventId
  +Integer verseId
  +String audioUri
  +AssistanceType assistanceType
  +DateTime? playedAt
  +markPlayed(DateTime) void
  +validateSingleTrigger() Boolean
}
class AIMode {
  <<entity>>
  +Integer aiModeId
  +AIModeCode modeCode
  +Boolean active
  +isSelectable() Boolean
}
class AIModeCode {
  <<enumeration>>
  AL_MUJAWWID
  AL_MUSHAJJI
  AL_MUALLIM
}
class SessionStatus {
  <<enumeration>>
  ACTIVE
  COMPLETED
  ABANDONED
  FAILED
}
class SegmentStatus {
  <<enumeration>>
  CAPTURED
  PROCESSING
  ANALYZED
  FAILED
}
class AnalysisStatus {
  <<enumeration>>
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
class PauseType {
  <<enumeration>>
  NATURAL
  HESITATION
  FORGOTTEN
  TECHNICAL
}
class ErrorCategory {
  <<enumeration>>
  PRONUNCIATION
  TAJWEED
  OMISSION
  INSERTION
  SUBSTITUTION
  FLUENCY
}
class ReviewStatus {
  <<enumeration>>
  UNREVIEWED
  ACCEPTED
  REJECTED
  CORRECTED
}
class FeedbackType {
  <<enumeration>>
  TEXT
  VISUAL
  INSTRUCTION
}
class AssistanceType {
  <<enumeration>>
  CORRECTION
  CONTINUATION
  EXAMPLE
}
class RecitationService {
  <<service>>
  +startSession(UUID, Integer, Integer) RecitationSession
  +captureSegment(UUID, Integer) RecitationSegment
  +recordPause(UUID, PauseEvent) PauseEvent
  +endSession(UUID) RecitationSession
  +abandonSession(UUID) RecitationSession
}
class AnalysisService {
  <<service>>
  +analyzeSegment(UUID) RecitationAnalysis
  +reanalyzeSegment(UUID) RecitationAnalysis
  +getSupportedTajweedRules() List~TajweedRule~
}
class FeedbackService {
  <<service>>
  +buildFeedback(UUID, LanguageCode) List~ErrorFeedback~
  +provideAudioAssistance(UUID) AudioAssistance
}
class RecitationRepository {
  <<repository>>
  +findSession(UUID) RecitationSession?
  +saveSession(RecitationSession) RecitationSession
  +saveSegment(RecitationSegment) RecitationSegment
  +saveAnalysis(RecitationAnalysis) RecitationAnalysis
}
class AudioCapturePort {
  <<external>>
  +startCapture(UUID) void
  +readSegment() AudioData
  +stopCapture() AudioData
}
class AIAnalysisPort {
  <<external>>
  +analyze(AudioData, Verse) AnalysisResult
  +supportedRules() List~TajweedRule~
}
class AudioData {
  <<value object>>
  +Binary content
  +String format
  +Integer durationMs
}
class AnalysisResult {
  <<value object>>
  +String recognizedText
  +Decimal confidence
  +List~RecitationError~ errors
}

RecitationSession "1" *-- "0..*" RecitationSegment : contains

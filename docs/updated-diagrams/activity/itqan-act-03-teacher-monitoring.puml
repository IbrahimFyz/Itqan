@startuml itqan-act-03-teacher-monitoring
' Itqan — Activity Diagram 03: Teacher monitoring
' Built only from Itqan_Requirements.md and USE_CASE_SCENARIOS.md: UC-18 with
' its exceptions; FR-23; BR-08; NFR-06.
<style>
root {
  FontName Helvetica
  FontSize 12
  FontColor #000000
  BackGroundColor #FFFFFF
  LineColor #000000
  LineThickness 0.75
  RoundCorner 0
  Shadowing 0
}

note { BackGroundColor #FFFFFF; LineColor #000000; FontColor #000000 }

activityDiagram {
  activity    { BackGroundColor #FFFFFF; LineColor #000000; FontColor #000000; RoundCorner 10 }
  diamond     { BackGroundColor #FFFFFF; LineColor #000000 }
  activityBar { BackGroundColor #000000; LineColor #000000 }
  arrow       { LineColor #000000; LineThickness 0.75 }
  swimlane    { LineColor #000000; LineThickness 0.75 }
}
</style>

|Teacher|
start
:Open dashboard (UC-18);
|Itqan System|
if (Teacher has classes?) then (no)
  :Prompt to create a class (UC-17);
  stop
else (yes)
endif
:List the teacher's classes;
|Teacher|
:Select class;
|Itqan System|
if (Any actively enrolled readers?) then (no)
  :Show the class's join code;
  stop
else (yes)
endif
:List enrolled readers with summaries
(sessions from each join date);
|Teacher|
:Select reader;
|Itqan System|
if (Enrolment still active?) then (no)
  :Deny access;
  stop
else (yes)
endif
:List sessions ended on or
after the join date (BR-08);
note right
  Empty list if the reader has
  no visible sessions yet
end note
|Teacher|
:Select session;
|Itqan System|
:Show the session's mistakes
(word, error type, rule);
|Teacher|
stop

@enduml

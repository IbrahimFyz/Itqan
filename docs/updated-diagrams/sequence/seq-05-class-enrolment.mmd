---
title: SEQ-05 — Class management and enrolment (UC-17, UC-26, UC-27)
config:
  theme: neutral
---
sequenceDiagram
    actor Teacher as Teacher
    actor Reader as Quran Reader
    participant App as Itqan App
    participant Class as Class Service
    participant Account as Account Service
    participant DB as Database
    alt UC-17 Create Class
        Teacher->>App: Enter class name
        alt Name empty
            App-->>Teacher: Refuse and request a name
        else Name valid
            App->>Class: createOrRenameClass(create, name)
            Class->>DB: Create Teacher-owned Class with unique join code
            Note over DB: Names may repeat, join code never changes, no class status
            DB-->>Class: New Class and join code
            Class-->>App: Class and code
            App-->>Teacher: Show code to share outside app
        end
    else UC-17 Rename Class
        Teacher->>App: Select own Class and enter new name
        alt Name empty
            App-->>Teacher: Refuse change
        else Name valid
            App->>Class: createOrRenameClass(rename, Class, name)
            Class->>DB: Check Teacher owns Class and update name only
            DB-->>Class: Same join code
            Class-->>App: Renamed Class
            App-->>Teacher: Show unchanged code
        end
    else UC-26 Join Class via code
        Reader->>App: Enter join code
        App->>Class: Find Class by code and check active membership
        Class->>DB: Read Class, Teacher name and active Enrolment
        alt Code invalid or Class erased
            DB-->>Class: No Class
            Class-->>App: Code not found
            App-->>Reader: No enrolment created
        else Already actively enrolled
            DB-->>Class: Active Enrolment exists
            Class-->>App: Already in this Class
            App-->>Reader: No new enrolment
        else Valid code and not active
            DB-->>Class: Class and Teacher display name
            Class-->>App: Show Class and Teacher
            App-->>Reader: Ask for teacher-sharing consent
            alt Reader declines consent
                App-->>Reader: Do not join
            else Reader grants consent
                App->>Account: grantOrWithdrawConsent(grant, teacher sharing)
                Account->>DB: Record dated consent grant if no active grant
                DB-->>Account: Active teacher-sharing consent
                Account-->>App: Consent active
                App->>Class: joinOrLeaveClass(join, Reader, Class)
                Class->>DB: Recheck code and consent, insert new active Enrolment
                Note over DB: At most one active row per Reader and Class, rejoin gets new join date
                DB-->>Class: Enrolment and join date
                Class-->>App: Joined
                App-->>Reader: Show Class in My Classes
                Note over Reader,DB: A Reader may join several Classes, rejoining this one creates a fresh row
            end
        end
    else UC-27 Leave Class
        Reader->>App: Open My Classes and choose Leave
        App->>Class: List active Classes
        Class->>DB: Read Reader's active Enrolments
        alt No active Classes
            DB-->>Class: Empty
            Class-->>App: Empty state
            App-->>Reader: No Classes to leave
        else Active Class selected
            DB-->>Class: Active Class list
            Class-->>App: Classes
            App-->>Reader: Ask to confirm Leave
            alt Reader cancels
                App-->>Reader: Nothing changes
            else Reader confirms
                App->>Class: joinOrLeaveClass(leave, Reader, Class)
                Class->>DB: End Enrolment with leftAt and reason left
                DB-->>Class: Enrolment ended
                Class-->>App: Left Class
                App-->>Reader: Class removed from active list
                Note over DB: Teacher access stops, delivered messages remain
            end
        end
    end
    Note over Teacher,Class: Teachers cannot add or remove Readers or delete one Class

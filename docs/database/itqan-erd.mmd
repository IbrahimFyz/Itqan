erDiagram
    %% IDENTITY AND ACCESS
    USER {
        uuid user_id PK
        varchar email UK
        varchar identity_subject UK
        varchar display_name
        varchar preferred_language
        varchar account_status
        datetime created_at
        datetime updated_at
        datetime last_login_at
    }
    ROLE {
        smallint role_id PK
        varchar role_code UK
        varchar role_name_ar
        varchar role_name_en
    }
    USER_ROLE {
        uuid user_id PK, FK
        smallint role_id PK, FK
        datetime assigned_at
    }
    LEARNER_PROFILE {
        uuid learner_id PK, FK
        text learning_goal
        varchar experience_level
        boolean reminders_enabled
    }
    TEACHER_PROFILE {
        uuid teacher_id PK, FK
        varchar school_name
        text biography
        text qualification
    }
    CONSENT_RECORD {
        uuid consent_id PK
        uuid user_id FK
        varchar purpose_code
        varchar policy_version
        varchar collection_method
        datetime granted_at
        datetime withdrawn_at
    }

    %% QURAN CONTENT AND TAJWEED REFERENCE DATA
    JUZ {
        smallint juz_id PK
        smallint juz_number UK
        varchar name_ar
        varchar name_en
    }
    SURAH {
        smallint surah_id PK
        smallint juz_id FK
        varchar name_ar
        varchar name_en
        smallint revelation_order
        varchar revelation_type
        smallint verse_count
        smallint display_order UK
    }
    VERSE {
        integer verse_id PK
        smallint surah_id FK
        smallint verse_number
        text uthmani_text
        text normalized_text
        smallint page_number
        smallint hizb_number
    }
    VERSE_WORD {
        bigint word_id PK
        integer verse_id FK
        smallint word_position
        varchar uthmani_text
        varchar normalized_text
    }
    TAJWEED_RULE {
        smallint tajweed_rule_id PK
        varchar rule_code UK
        varchar name_ar
        varchar name_en
        text description_ar
        text description_en
        boolean is_supported
    }

    %% AI MODES AND RECITATION SESSIONS
    AI_MODE {
        smallint ai_mode_id PK
        varchar mode_code UK
        varchar name_ar
        varchar name_en
        text description
        boolean is_active
    }
    RECITATION_SESSION {
        uuid session_id PK
        uuid learner_id FK
        smallint surah_id FK
        smallint ai_mode_id FK
        datetime started_at
        datetime ended_at
        varchar session_status
        decimal completion_percentage
        decimal mastery_score
        integer total_duration_seconds
        integer total_pause_count
        integer error_count
        text failure_reason
    }
    RECITATION_SEGMENT {
        uuid segment_id PK
        uuid session_id FK
        integer verse_id FK
        smallint segment_order
        integer audio_start_ms
        integer audio_end_ms
        text recognized_text
        decimal confidence_score
        decimal fluency_score
        varchar segment_status
    }
    RECITATION_ANALYSIS {
        uuid analysis_id PK
        uuid segment_id FK, UK
        varchar analysis_status
        varchar model_name
        varchar model_version
        integer processing_time_ms
        datetime analyzed_at
        decimal overall_confidence
        text failure_reason
    }
    PAUSE_EVENT {
        uuid pause_event_id PK
        uuid session_id FK
        uuid segment_id FK
        integer started_at_ms
        integer duration_ms
        varchar pause_type
        boolean prompt_triggered
        integer prompt_delay_ms
    }

    %% ERROR DETECTION AND FEEDBACK
    ERROR_TYPE {
        smallint error_type_id PK
        smallint tajweed_rule_id FK
        varchar error_code UK
        varchar category
        varchar name_ar
        varchar name_en
        varchar severity
        text description
    }
    RECITATION_ERROR {
        uuid recitation_error_id PK
        uuid analysis_id FK
        smallint error_type_id FK
        bigint word_id FK
        text detected_text
        text expected_text
        integer audio_start_ms
        integer audio_end_ms
        decimal confidence_score
        varchar review_status
        datetime detected_at
    }
    ERROR_FEEDBACK {
        uuid feedback_id PK
        uuid recitation_error_id FK
        varchar feedback_type
        varchar language_code
        text feedback_text
        text correction_text
        datetime created_at
    }
    AUDIO_ASSISTANCE {
        uuid assistance_id PK
        uuid recitation_error_id FK
        uuid pause_event_id FK
        integer verse_id FK
        text audio_uri
        varchar assistance_type
        datetime played_at
    }

    %% PROGRESS AND PRACTICE HISTORY
    LEARNER_SURAH_PROGRESS {
        uuid learner_id PK, FK
        smallint surah_id PK, FK
        integer attempt_count
        integer completed_session_count
        decimal best_mastery_score
        decimal average_mastery_score
        decimal latest_mastery_score
        boolean is_fully_mastered
        datetime first_practiced_at
        datetime last_practiced_at
        datetime mastered_at
    }
    MASTERY_SCORE_HISTORY {
        uuid mastery_history_id PK
        uuid learner_id FK
        smallint surah_id FK
        uuid session_id FK, UK
        integer total_words
        decimal effective_errors
        decimal final_mastery_score
        datetime calculated_at
        varchar formula_version
    }
    DAILY_PRACTICE {
        uuid learner_id PK, FK
        date practice_date PK
        integer session_count
        integer completed_session_count
        integer total_practice_seconds
        integer verses_practiced
    }
    PRACTICE_STREAK {
        uuid learner_id PK, FK
        integer current_streak_days
        integer longest_streak_days
        date current_streak_started_on
        date last_practice_date
        datetime updated_at
    }

    %% TEACHER, CLASS, AND COMMUNICATION FUNCTIONS
    LEARNING_CLASS {
        uuid class_id PK
        uuid teacher_id FK
        varchar class_name
        text description
        varchar join_code UK
        varchar class_status
        datetime created_at
        datetime updated_at
    }
    CLASS_ENROLLMENT {
        uuid enrollment_id PK
        uuid class_id FK
        uuid learner_id FK
        varchar enrollment_status
        datetime enrolled_at
        datetime ended_at
    }
    %% PROPOSED DETAIL
    CLASS_ASSIGNMENT {
        uuid assignment_id PK "PROPOSED"
        uuid class_id FK
        smallint surah_id FK
        uuid created_by FK
        varchar title
        text instructions
        decimal target_mastery_score
        datetime due_at
        datetime created_at
    }
    %% PROPOSED DETAIL
    ASSIGNMENT_PROGRESS {
        uuid assignment_id PK, FK "PROPOSED"
        uuid learner_id PK, FK
        uuid best_session_id FK
        varchar assignment_status
        decimal best_mastery_score
        datetime completed_at
        datetime updated_at
    }
    TEACHER_MESSAGE {
        uuid message_id PK
        uuid teacher_id FK
        uuid learner_id FK
        uuid class_id FK
        uuid session_id FK
        text message_text
        datetime sent_at
        datetime read_at
    }
    %% PROPOSED REPORTING CACHE
    LEARNER_PERFORMANCE_SNAPSHOT {
        uuid snapshot_id PK "PROPOSED"
        uuid class_id FK
        uuid learner_id FK
        datetime generated_at
        smallint completed_surah_count
        decimal average_mastery_score
        integer total_sessions
        integer total_practice_seconds
        integer current_streak_days
    }

    %% PROPOSED AL-MUSHAJJI GAMIFICATION
    CHALLENGE {
        uuid challenge_id PK "PROPOSED"
        varchar title_ar
        varchar title_en
        text description_ar
        text description_en
        varchar challenge_type
        integer target_value
        datetime starts_at
        datetime ends_at
        boolean is_active
    }
    %% PROPOSED AL-MUSHAJJI GAMIFICATION
    LEARNER_CHALLENGE {
        uuid learner_id PK, FK "PROPOSED"
        uuid challenge_id PK, FK
        integer progress_value
        varchar challenge_status
        datetime joined_at
        datetime completed_at
    }
    %% PROPOSED AL-MUSHAJJI GAMIFICATION
    REWARD {
        uuid reward_id PK "PROPOSED"
        varchar reward_code UK
        varchar name_ar
        varchar name_en
        text description
        varchar reward_type
    }
    %% PROPOSED AL-MUSHAJJI GAMIFICATION
    LEARNER_REWARD {
        uuid learner_id PK, FK "PROPOSED"
        uuid reward_id PK, FK
        uuid challenge_id FK
        datetime awarded_at
    }


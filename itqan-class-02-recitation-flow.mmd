classDiagram
direction TB

class ItqanApp {
  +browseAndReadSurah()
  +captureVerseAudio()
  +showVerseFeedback()
  +detectPause()
  +showNextWordHint()
  +playBundledWordAudio()
  +showResults()
}
class RecitationService {
  +startSession(readerId, surahNumber, mode)
  +analyseVerse(sessionId, verseNumber, verseAudio)
  +endSession(sessionId, reason)
  +calculateScore(sessionId)
  +saveEndedSession(sessionId)
}
class ComparisonEngine {
  +compareVerse(phonemes, expectedVerse)
  +locateMistakes()
}
class AnalysisService {
  <<stateless external service>>
  +analyseVerseAudio()
}
class Word {
  <<reference: view 1>>
}
class RecitationSession {
  <<reference: view 3>>
}
class ProgressService {
  <<reference: view 3>>
}

ItqanApp ..> RecitationService : all session traffic
ItqanApp ..> ProgressService : results and history
RecitationService *-- ComparisonEngine : contains
RecitationService ..> AnalysisService : verse audio in memory
ComparisonEngine ..> Word : reads expected text
RecitationService ..> RecitationSession : finalizes
RecitationService ..> ProgressService : after session end
